---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const labs = await getCollection('labs', ({ data }) => data.status === 'ready');
  return labs.map((lab) => ({ params: { slug: lab.id }, props: { lab } }));
}

const { lab } = Astro.props;
const { Content } = await render(lab);
const isStaticVsCurrentLab = lab.id === 'lesson-2-static-vs-moving-electricity';
---

<BaseLayout title={lab.data.title} description={lab.data.summary}>
  <article class="lab-page">
    <div class="container article-container lab-intro">
      <p class="eyebrow">Interactive artifact</p>
      <h1>{lab.data.title}</h1>
      <p class="lede">{lab.data.summary}</p>
      <div class="prose compact">
        <Content />
      </div>
    </div>

    {isStaticVsCurrentLab ? (
      <section class="container lab-shell contrast-lab-shell" aria-labelledby="lab-title" data-static-current-lab>
        <div class="lab-board contrast-lab-board">
          <div class="lab-board-header">
            <div>
              <p class="eyebrow">Static vs moving electricity</p>
              <h2 id="lab-title">One spark or a steady loop.</h2>
            </div>
            <p class="lab-status" data-contrast-status>Static charge is building. Current needs a closed loop.</p>
          </div>

          <div class="contrast-stage" aria-label="Static and current electricity visual comparison">
            <section class="contrast-panel static-panel" aria-labelledby="static-panel-title">
              <p class="panel-label">Static electricity</p>
              <h3 id="static-panel-title">Charge imbalance</h3>
              <div class="static-scene" aria-hidden="true">
                <div class="charged-object charged-object-negative">
                  <span class="charge-dot dot-a">−</span>
                  <span class="charge-dot dot-b">−</span>
                  <span class="charge-dot dot-c">−</span>
                  <span class="charge-dot dot-d">−</span>
                </div>
                <div class="spark-gap" data-spark-gap>
                  <span class="field-line field-line-one"></span>
                  <span class="field-line field-line-two"></span>
                  <span class="field-line field-line-three"></span>
                  <span class="spark" data-spark></span>
                  <span class="spark-label">brief discharge</span>
                </div>
                <div class="charged-object charged-object-positive">
                  <span class="charge-dot dot-e">+</span>
                  <span class="charge-dot dot-f">+</span>
                  <span class="charge-dot dot-g">+</span>
                </div>
              </div>
              <p class="panel-note" data-static-note>Separated charge creates an electric field. It can discharge briefly.</p>
            </section>

            <section class="contrast-panel current-panel" aria-labelledby="current-panel-title">
              <p class="panel-label">Moving electricity</p>
              <h3 id="current-panel-title">Sustained current</h3>
              <svg class="mini-circuit" viewBox="0 0 420 210" role="img" aria-labelledby="mini-circuit-title mini-circuit-desc">
                <title id="mini-circuit-title">Simple current electricity model</title>
                <desc id="mini-circuit-desc">A source, closed wire path, load, and moving charge markers show sustained current.</desc>
                <path class="mini-flow-trace" data-mini-flow d="M70 110 H165 V55 H330 V155 H165 V110 H70" />
                <path id="mini-current-path" class="mini-wire" data-mini-wire d="M70 110 H165 V55 H330 V155 H165 V110 H70" />
                <g class="mini-battery" transform="translate(38 78)">
                  <rect width="58" height="64" rx="12" />
                  <line x1="58" y1="32" x2="95" y2="32" />
                  <text x="29" y="29">Source</text>
                  <text x="29" y="47" data-source-label>6 V</text>
                </g>
                <g class="mini-switch" data-mini-switch transform="translate(148 110)">
                  <line class="mini-switch-mask" x1="-20" y1="0" x2="22" y2="0" />
                  <circle class="mini-switch-terminal" cx="-17" cy="0" r="5" />
                  <circle class="mini-switch-terminal" cx="19" cy="0" r="5" />
                  <line class="mini-switch-lever" x1="-17" y1="0" x2="19" y2="0" />
                </g>
                <g class="mini-load" transform="translate(305 130)">
                  <circle cx="24" cy="24" r="27" data-mini-bulb />
                  <path d="M11 24 C17 12 31 36 37 24" />
                  <text x="24" y="66">Load</text>
                </g>
                <circle class="mini-charge" data-mini-charge r="7">
                  <animateMotion data-mini-motion dur="4s" begin="0s" repeatCount="indefinite" calcMode="linear">
                    <mpath href="#mini-current-path" />
                  </animateMotion>
                </circle>
                <circle class="mini-charge" data-mini-charge r="7">
                  <animateMotion data-mini-motion dur="4s" begin="-1.3s" repeatCount="indefinite" calcMode="linear">
                    <mpath href="#mini-current-path" />
                  </animateMotion>
                </circle>
                <circle class="mini-charge" data-mini-charge r="7">
                  <animateMotion data-mini-motion dur="4s" begin="-2.6s" repeatCount="indefinite" calcMode="linear">
                    <mpath href="#mini-current-path" />
                  </animateMotion>
                </circle>
              </svg>
              <p class="panel-note" data-current-note>A source keeps the voltage difference going through a closed path and load.</p>
            </section>
          </div>
        </div>

        <div class="lab-controls" aria-label="Static and current controls">
          <label class="control">
            <span>Static charge imbalance</span>
            <input data-static-charge type="range" min="0" max="10" step="1" value="6" />
            <output data-static-output>6 / 10</output>
          </label>
          <button class="button button-secondary lab-action" type="button" data-discharge>Release static discharge</button>
          <label class="control">
            <span>Source voltage for the loop</span>
            <input data-source-voltage type="range" min="0" max="12" step="1" value="6" />
            <output data-source-output>6 V</output>
          </label>
          <label class="switch-control">
            <input data-current-loop type="checkbox" checked />
            <span>Close the current loop</span>
          </label>
        </div>

        <div class="meters contrast-meters" aria-label="Comparison readings">
          <div class="meter">
            <span>Static side</span>
            <strong data-static-reading>Built up</strong>
            <p>Charge can sit separated. The visible event is a brief discharge.</p>
          </div>
          <div class="meter">
            <span>Current side</span>
            <strong data-current-reading>Flowing</strong>
            <p>Charges keep moving only while the source and closed path remain.</p>
          </div>
        </div>

        <aside class="formula-card" aria-label="Lesson model used in this lab">
          <h2>The simple difference</h2>
          <ul>
            <li><strong>Static:</strong> imbalance first, then possible brief discharge.</li>
            <li><strong>Current:</strong> source plus closed path plus load, producing sustained flow.</li>
            <li>A spark is not the same thing as a working circuit.</li>
          </ul>
        </aside>
      </section>
    ) : (
      <section class="container lab-shell" aria-labelledby="lab-title" data-energy-lab>
        <div class="lab-board">
          <div class="lab-board-header">
            <div>
              <p class="eyebrow">Simple circuit model</p>
              <h2 id="lab-title">Push, flow, work, loop.</h2>
            </div>
            <p class="lab-status" data-status>Closed loop. Current is flowing.</p>
          </div>

          <svg class="circuit" viewBox="0 0 760 380" role="img" aria-labelledby="circuit-title circuit-desc">
            <title id="circuit-title">Interactive simple circuit diagram</title>
            <desc id="circuit-desc">A battery, wire loop, resistance load, and moving charge markers controlled by voltage and resistance sliders.</desc>
            <defs>
              <linearGradient id="wireGradient" x1="0%" x2="100%">
                <stop offset="0%" stop-color="#38bdf8" />
                <stop offset="100%" stop-color="#f59e0b" />
              </linearGradient>
            </defs>
            <path id="charge-path" class="wire" data-wire d="M170 190 H330 V110 H590 V270 H330 V190 H170" />
            <g class="battery" transform="translate(110 135)">
              <rect width="80" height="110" rx="16" />
              <line x1="80" y1="55" x2="128" y2="55" />
              <text x="40" y="48">Battery</text>
              <text class="battery-voltage" data-svg-voltage x="40" y="72">5.0 V</text>
            </g>
            <g class="load" transform="translate(560 235)">
              <circle cx="30" cy="35" r="38" data-bulb />
              <path d="M14 35 C22 20 38 50 46 35" />
              <text x="30" y="96">Load</text>
            </g>
            <g class="resistor" transform="translate(345 90)">
              <path d="M0 20 h25 l10 -18 l20 36 l20 -36 l20 36 l10 -18 h25" />
              <text x="65" y="62">Resistance</text>
              <text class="resistance-label" data-svg-resistance x="65" y="84">20 Ω</text>
            </g>
            <circle class="charge charge-one" data-charge r="9">
              <animateMotion data-charge-motion dur="4s" begin="0s" repeatCount="indefinite" calcMode="linear">
                <mpath href="#charge-path" />
              </animateMotion>
            </circle>
            <circle class="charge charge-two" data-charge r="9">
              <animateMotion data-charge-motion dur="4s" begin="-1s" repeatCount="indefinite" calcMode="linear">
                <mpath href="#charge-path" />
              </animateMotion>
            </circle>
            <circle class="charge charge-three" data-charge r="9">
              <animateMotion data-charge-motion dur="4s" begin="-2s" repeatCount="indefinite" calcMode="linear">
                <mpath href="#charge-path" />
              </animateMotion>
            </circle>
            <circle class="charge charge-four" data-charge r="9">
              <animateMotion data-charge-motion dur="4s" begin="-3s" repeatCount="indefinite" calcMode="linear">
                <mpath href="#charge-path" />
              </animateMotion>
            </circle>
          </svg>
        </div>

        <div class="lab-controls" aria-label="Circuit controls">
          <label class="control">
            <span>Voltage, the push from the battery</span>
            <input data-voltage type="range" min="1" max="12" step="0.1" value="5" />
            <output data-voltage-output>5.0 V</output>
          </label>
          <label class="control">
            <span>Resistance, the limit on flow</span>
            <input data-resistance type="range" min="2" max="80" step="1" value="20" />
            <output data-resistance-output>20 Ω</output>
          </label>
          <label class="control">
            <span>Time, how long energy is transferred</span>
            <input data-time type="range" min="1" max="60" step="1" value="10" />
            <output data-time-output>10 s</output>
          </label>
          <label class="switch-control">
            <input data-loop type="checkbox" checked />
            <span>Close the loop</span>
          </label>
        </div>

        <div class="meters" aria-label="Circuit readings">
          <div class="meter">
            <span>Current</span>
            <strong data-current>0.25 A</strong>
            <p>Current is flow. It rises with voltage and falls with resistance.</p>
          </div>
          <div class="meter">
            <span>Power</span>
            <strong data-power>1.25 W</strong>
            <p>Power is work per second. It depends on both push and flow.</p>
          </div>
          <div class="meter">
            <span>Energy transferred</span>
            <strong data-energy>12.5 J</strong>
            <p>Energy grows as power continues over time.</p>
          </div>
        </div>

        <aside class="formula-card" aria-label="Formulas used in this lab">
          <h2>The relationships</h2>
          <ul>
            <li><strong>Current</strong> = voltage divided by resistance.</li>
            <li><strong>Power</strong> = voltage multiplied by current.</li>
            <li><strong>Energy</strong> = power multiplied by time.</li>
            <li>If the loop opens, sustained current stops.</li>
          </ul>
        </aside>
      </section>
    )}
  </article>
  {isStaticVsCurrentLab ? (
    <script type="module" src="/scripts/static-current-lab.js"></script>
  ) : (
    <script type="module" src="/scripts/energy-flow-lab.js"></script>
  )}
</BaseLayout>

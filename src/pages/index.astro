---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lessons = (await getCollection('lessons', ({ data }) => data.status === 'ready')).sort(
  (a, b) => a.data.order - b.data.order
);
const labs = (await getCollection('labs', ({ data }) => data.status === 'ready')).sort(
  (a, b) => a.data.order - b.data.order
);
const latestLesson = lessons.at(-1) ?? lessons[0];
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Energy, from first principles</p>
        <h1 id="hero-title">Learn how energy moves through real systems.</h1>
        <p class="lede">
          Turtleand Energy starts small: beginner lessons for electricity, simple interactive labs, and a structure that grows only when the artifacts are real.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/labs/lesson-1-energy-flow/">Open the first lab</a>
          {latestLesson && <a class="button button-secondary" href={`/lessons/${latestLesson.id}/`}>Read the latest lesson</a>}
        </div>
      </div>
      <aside class="hero-card" aria-label="Current surface status">
        <p class="card-kicker">Now live</p>
        <h2>Two foundation lessons plus two simple labs</h2>
        <p>
          The homepage stays focused on real artifacts: first principles, the static-versus-current distinction, and working visual models.
        </p>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="current-work-title">
    <div class="container section-grid">
      <div class="section-heading">
        <p class="eyebrow">Start here</p>
        <h2 id="current-work-title">The foundation path.</h2>
        <p>
          Begin with source, loop, load, and energy flow. Then separate brief static discharge from sustained current.
        </p>
      </div>

      <div class="content-cards">
        {lessons.map((lesson) => (
          <article class="content-card">
            <p class="card-kicker">Lesson</p>
            <h3>{lesson.data.title}</h3>
            <p>{lesson.data.summary}</p>
            <a href={`/lessons/${lesson.id}/`}>Read the model</a>
          </article>
        ))}
        {labs.map((lab) => (
          <article class="content-card content-card-accent">
            <p class="card-kicker">Interactive lab</p>
            <h3>{lab.data.title}</h3>
            <p>{lab.data.summary}</p>
            <a href={`/labs/${lab.id}/`}>Open the lab</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

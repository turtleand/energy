---
import curricula from '@data/curricula.json';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lessons = (await getCollection('lessons', ({ data }) => data.status === 'ready')).sort(
  (a, b) => a.data.order - b.data.order,
);
const games = (await getCollection('games', ({ data }) => data.status === 'ready')).sort(
  (a, b) => a.data.order - b.data.order,
);
const falstadExercises = (
  await getCollection('falstadExercises', ({ data }) => data.status === 'ready')
).sort((a, b) => a.data.order - b.data.order);
const curriculum = curricula
  .filter((candidate) => candidate.status === 'published')
  .sort((a, b) => a.order - b.order)[0];
const firstLesson = lessons[0];
---

<BaseLayout>
  <section class="hero home-hero" aria-labelledby="hero-title">
    <div class="container hero-copy">
      <p class="eyebrow">Energy, from first principles</p>
      <h1 id="hero-title">See how electricity becomes a working system.</h1>
      <p class="lede">
        Start with one clear lesson path. Then build circuits, reinforce the ideas through play,
        or use the deeper curriculum to choose what to study next.
      </p>
      {firstLesson && (
        <div class="hero-actions">
          <a class="button button-primary" href={`/lessons/${firstLesson.id}/`}>Start lesson 1</a>
        </div>
      )}
    </div>
  </section>

  <section class="learning-map-section" aria-labelledby="learning-map-title">
    <div class="container">
      <header class="section-heading">
        <p class="eyebrow">Choose your route</p>
        <h2 id="learning-map-title">One foundation. Three ways to continue.</h2>
        <p>Learn in order first. Practice, play, and deeper study become useful once the basic model is in place.</p>
      </header>

      <div class="learning-map">
        <a class="learning-route learning-route-primary" href="/learn/">
          <span class="route-node" aria-hidden="true">01</span>
          <span class="route-copy">
            <span class="route-kicker">Start here</span>
            <strong>Learn the foundations</strong>
            <span>
              {lessons.length} connected lessons, each with a simulation that makes the model visible.
            </span>
          </span>
          <span class="route-action">Follow the lesson path</span>
        </a>

        <span class="route-branch" aria-hidden="true"><i></i><i></i><i></i></span>

        <div class="learning-branches">
          <a class="learning-route" href="/practice/falstad/">
            <span class="route-node" aria-hidden="true">02</span>
            <span class="route-copy">
              <span class="route-kicker">Practice</span>
              <strong>Build the circuits yourself</strong>
              <span>{falstadExercises.length} guided Falstad exercises from complete loops to transformers.</span>
            </span>
            <span class="route-action">Open circuit practice</span>
          </a>

          <a class="learning-route" href="/play/">
            <span class="route-node" aria-hidden="true">03</span>
            <span class="route-copy">
              <span class="route-kicker">Play</span>
              <strong>Restore a working grid</strong>
              <span>{games.length} games that turn the foundation lessons into connected missions.</span>
            </span>
            <span class="route-action">Choose a game</span>
          </a>

          {curriculum && (
            <a class="learning-route" href={`/curricula/${curriculum.slug}/`}>
              <span class="route-node" aria-hidden="true">04</span>
              <span class="route-copy">
                <span class="route-kicker">Go deeper</span>
                <strong>Plan the next layer</strong>
                <span>
                  A {curriculum.modules.length}-module reference outline for circuits, electronics,
                  measurement, and control.
                </span>
              </span>
              <span class="route-action">View the curriculum outline</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const learningPaths = (await getCollection('learningPaths', ({ data }) => data.status === 'ready')).sort(
  (a, b) => a.data.order - b.data.order
);
const lessons = (await getCollection('lessons', ({ data }) => data.status === 'ready')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-copy">
      <p class="eyebrow">Energy, from first principles</p>
      <h1 id="hero-title">Learn how energy moves through real systems.</h1>
      <p class="lede">
        Turtleand Energy starts small: clear articles first, with simulations inside the lesson when a model needs to become visible.
      </p>
    </div>
  </section>

  <section class="section learning-path-index" aria-labelledby="learning-path-index-title">
    <div class="container">
      <div class="index-heading">
        <p class="eyebrow">Learning paths</p>
        <h2 id="learning-path-index-title">Start with the map.</h2>
      </div>

      <div class="content-cards path-cards">
        {learningPaths.map((learningPath) => (
          <a
            class="content-card article-card path-card"
            href={`/learning-paths/${learningPath.id}/`}
            aria-label={`Read ${learningPath.data.title}`}
          >
            <div>
              <p class="card-kicker">Path {learningPath.data.order.toString().padStart(2, '0')}</p>
              <h3>{learningPath.data.title}</h3>
              <p>{learningPath.data.summary}</p>
            </div>
            <div class="card-footer">
              <span class="card-link">Open path</span>
              <span>Beginner ladder</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section article-index" aria-labelledby="article-index-title">
    <div class="container">
      <div class="index-heading">
        <p class="eyebrow">Articles</p>
        <h2 id="article-index-title">Current articles.</h2>
      </div>

      <div class="content-cards article-cards">
        {lessons.map((lesson) => (
          <a
            class="content-card article-card"
            href={`/lessons/${lesson.id}/`}
            aria-label={`Read ${lesson.data.title}`}
          >
            <div>
              <p class="card-kicker">Lesson {lesson.data.order.toString().padStart(2, '0')}</p>
              <h3>{lesson.data.title}</h3>
              <p>{lesson.data.summary}</p>
            </div>
            <div class="card-footer">
              <span class="card-link">Read article</span>
              {lesson.data.labSlug && <span>Simulation inside</span>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

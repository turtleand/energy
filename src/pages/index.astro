---
import curricula from '@data/curricula.json';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lessons = (await getCollection('lessons', ({ data }) => data.status === 'ready')).sort(
  (a, b) => a.data.order - b.data.order,
);
const games = (await getCollection('games', ({ data }) => data.status === 'ready')).sort(
  (a, b) => a.data.order - b.data.order,
);
const falstadExercises = (
  await getCollection('falstadExercises', ({ data }) => data.status === 'ready')
).sort((a, b) => a.data.order - b.data.order);
const curriculum = curricula
  .filter((candidate) => candidate.status === 'published')
  .sort((a, b) => a.order - b.order)[0];
const firstLesson = lessons[0];
---

<BaseLayout>
  <section class="hero home-hero" aria-labelledby="hero-title">
    <div class="container hero-copy">
      <p class="eyebrow">Energy, from first principles</p>
      <h1 id="hero-title">See how electricity becomes a working system.</h1>
      <p class="lede">
        Start with one clear lesson path. Then build circuits, reinforce the ideas through play,
        or use the deeper curriculum to choose what to study next.
      </p>
      {firstLesson && (
        <div class="hero-actions">
          <a class="button button-primary" href={`/lessons/${firstLesson.id}/`}>Start lesson 1</a>
        </div>
      )}
    </div>
  </section>

  <section class="learning-map-section" aria-labelledby="learning-map-title">
    <div class="container">
      <header class="section-heading">
        <p class="eyebrow">Choose your route</p>
        <h2 id="learning-map-title">Start with the foundations. Add what helps.</h2>
        <p>The lesson path builds the model. Everything beside it is optional.</p>
      </header>

      <div class="learning-launchpad">
        <a class="learning-primary" href="/learn/">
          <span class="route-kicker">Primary path</span>
          <span class="learning-primary-copy">
            <strong>Learn the foundations</strong>
            <span>
              {lessons.length} connected lessons, each with a simulation that makes the model visible.
            </span>
          </span>
          <span class="button button-primary">Follow the lesson path</span>
        </a>

        <section class="optional-paths" aria-labelledby="optional-paths-title">
          <header class="optional-paths-heading">
            <span>
              <span class="route-kicker">Optional next steps</span>
              <h3 id="optional-paths-title">Choose by goal</h3>
            </span>
            <p>Choose one, combine them, or return later.</p>
          </header>

          <nav class="optional-route-list" aria-label="Optional paths after foundations">
            <a class="optional-route optional-route-practice" href="/practice/falstad/">
              <span class="optional-route-marker" aria-hidden="true"></span>
              <span class="optional-route-copy">
                <span class="route-kicker">Practice</span>
                <strong>Build circuits from blank</strong>
                <span>{falstadExercises.length} guided exercises</span>
              </span>
              <span class="optional-route-arrow" aria-hidden="true">→</span>
            </a>

            <a class="optional-route optional-route-play" href="/play/">
              <span class="optional-route-marker" aria-hidden="true"></span>
              <span class="optional-route-copy">
                <span class="route-kicker">Play</span>
                <strong>Reinforce ideas through missions</strong>
                <span>{games.length} games</span>
              </span>
              <span class="optional-route-arrow" aria-hidden="true">→</span>
            </a>

            {curriculum && (
              <a
                class="optional-route optional-route-deeper"
                href={`/curricula/${curriculum.slug}/`}
              >
                <span class="optional-route-marker" aria-hidden="true"></span>
                <span class="optional-route-copy">
                  <span class="route-kicker">Go deeper</span>
                  <strong>Deepen your understanding</strong>
                  <span>{curriculum.modules.length}-module reference outline</span>
                </span>
                <span class="optional-route-arrow" aria-hidden="true">→</span>
              </a>
            )}
          </nav>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

            <span>3</span>
            Current leaks away
          </button>
        </div>

        <aside class="formula-card house-comparison-card" aria-label="House wiring protection rule">
          <h2>The whole mental model</h2>
          <div class="house-rule-grid">
            <div>
              <span>Normal</span>
              <strong>Live -> load -> neutral</strong>
              <p>The intended loop is complete. Ground stays quiet.</p>
            </div>
            <div>
              <span>Breaker or fuse</span>
              <strong>Too much current</strong>
              <p>Overloads and short circuits both belong in this bucket.</p>
            </div>
            <div>
              <span>GFCI/RCD</span>
              <strong>Current leaks away</strong>
              <p>It trips when live current and neutral return current do not match.</p>
            </div>
          </div>
        </aside>
      </section>
    ) : isNeighborhoodDistributionLab ? (
      <section
        class="container lab-shell neighborhood-distribution-shell"
        aria-labelledby="lab-title"
        data-neighborhood-distribution-lab
        data-neighborhood-voltage-level="medium"
      >
        <div class="lab-board neighborhood-board">
          <div class="lab-board-header">
            <div>
              <p class="eyebrow">Neighborhood distribution</p>
              <h2 id="lab-title">Feeder, transformer, service.</h2>
            </div>
            <p class="lab-status" data-neighborhood-status>60 kW neighborhood load at 7,200 V needs about 8.3 A on the feeder.</p>
          </div>

          <div class="neighborhood-stage" aria-label="Simplified neighborhood distribution model">
            <section class="neighborhood-node substation-node" aria-labelledby="substation-title">
              <p class="panel-label">Substation</p>
              <h3 id="substation-title">Lower from transmission</h3>
              <p>Transmission power is stepped down before it enters local distribution feeders.</p>
            </section>

            <section class="neighborhood-feeder-card" aria-labelledby="feeder-title">
              <p class="panel-label">Distribution feeder</p>
              <h3 id="feeder-title" data-neighborhood-feeder-label>7,200 V feeder</h3>
              <div class="neighborhood-feeder-line" aria-hidden="true">
                <span class="line-flow flow-one"></span>
                <span class="line-flow flow-two"></span>
                <span class="line-flow flow-three"></span>
              </div>
              <div class="heat-track neighborhood-heat-track" aria-label="Relative feeder heat loss">
                <span data-neighborhood-heat-bar></span>
              </div>
              <p data-neighborhood-feeder-note>Same neighborhood power, higher feeder voltage, lower feeder current.</p>
            </section>

            <section class="neighborhood-node transformer-service-node" aria-labelledby="local-transformer-title">
              <p class="panel-label">Local transformer</p>
              <h3 id="local-transformer-title">Step down near homes</h3>
              <div class="neighborhood-transformer" aria-hidden="true">
                <span></span>
                <span></span>
                <strong>240 V service</strong>
              </div>
              <p>The local transformer lowers feeder voltage for nearby service connections.</p>
            </section>

            <section class="neighborhood-home-card" aria-labelledby="home-load-title">
              <p class="panel-label">Home service</p>
              <h3 id="home-load-title">Load decides current</h3>
              <div class="home-load-stack" aria-hidden="true">
                <span class="home-load-chip is-on">lights</span>
                <span class="home-load-chip is-on">laptop</span>
                <span class="home-load-chip" data-home-heavy-chip>heater</span>
              </div>
              <p data-home-current-note>5 kW at 240 V needs about 20.8 A. Change the load to change the home current.</p>
            </section>
          </div>
        </div>

        <div class="lab-controls neighborhood-controls" aria-label="Neighborhood distribution controls">
          <label class="control">
            <span>Neighborhood load</span>
            <input data-neighborhood-power-input type="range" min="10" max="200" step="10" value="60" />
            <output data-neighborhood-power-output>60 kW</output>
          </label>
          <label class="control">
            <span>Feeder voltage</span>
            <select data-neighborhood-feeder-voltage-input>
              <option value="240">240 V, low educational feeder voltage</option>
              <option value="7200" selected>7,200 V, neighborhood feeder voltage</option>
              <option value="13200">13,200 V, higher feeder voltage</option>
            </select>
          </label>
          <label class="control">
            <span>Home active load</span>
            <input data-home-load-input type="range" min="1" max="12" step="1" value="5" />
            <output data-home-load-output>5 kW</output>
          </label>
        </div>

        <div class="meters neighborhood-readings" aria-label="Neighborhood distribution readings">
          <div class="meter">
            <span>Feeder current</span>
            <strong data-neighborhood-feeder-current>8.3 A</strong>
            <p>P = V × I, so feeder current falls when feeder voltage rises for the same load.</p>
          </div>
          <div class="meter">
            <span>Relative feeder heat</span>
            <strong data-neighborhood-heat>Low relative heat loss (0.11% of the 240 V case)</strong>
            <p>P_loss = I²R, so current has a squared effect in this simplified model.</p>
          </div>
          <div class="meter">
            <span>Home service current</span>
            <strong data-home-current>20.8 A</strong>
            <p>Home current changes with what devices are running.</p>
          </div>
        </div>

        <aside class="formula-card neighborhood-model-card" aria-label="Neighborhood distribution model summary">
          <h2>The distribution chain</h2>
          <ul>
            <li><strong>Substation:</strong> lowers transmission voltage for local distribution.</li>
            <li><strong>Feeder:</strong> carries neighborhood power at distribution voltage.</li>
            <li><strong>Local transformer:</strong> lowers voltage near homes.</li>
            <li><strong>Service current:</strong> changes with the active load inside the home.</li>
          </ul>
          <p class="neighborhood-note" data-neighborhood-note>
            Compared with 240 V, the default 7,200 V feeder uses 30× lower current and 900× lower heat in the simplified I²R model.
          </p>
        </aside>
      </section>
    ) : (
      <section class="container lab-shell" aria-labelledby="lab-title" data-energy-lab>
        <div class="lab-board">
          <div class="lab-board-header">
            <div>
              <p class="eyebrow">Simple circuit model</p>
              <h2 id="lab-title">Push, flow, work, loop.</h2>
            </div>
            <p class="lab-status" data-status>Closed loop. Current is flowing.</p>
          </div>

          <svg class="circuit" viewBox="0 0 760 380" role="img" aria-labelledby="circuit-title circuit-desc">
            <title id="circuit-title">Interactive simple circuit diagram</title>
            <desc id="circuit-desc">A battery, wire loop, resistance load, and moving charge markers controlled by voltage and resistance sliders.</desc>
            <defs>
              <linearGradient id="wireGradient" x1="0%" x2="100%">
                <stop offset="0%" stop-color="#38bdf8" />
                <stop offset="100%" stop-color="#f59e0b" />
              </linearGradient>
            </defs>
            <path id="charge-path" class="wire" data-wire d="M170 190 H330 V110 H590 V270 H330 V190 H170" />
            <g class="battery" transform="translate(110 135)">
              <rect width="80" height="110" rx="16" />
              <line x1="80" y1="55" x2="128" y2="55" />
              <text x="40" y="48">Battery</text>
              <text class="battery-voltage" data-svg-voltage x="40" y="72">5.0 V</text>
            </g>
            <g class="load" transform="translate(560 235)">
              <circle cx="30" cy="35" r="38" data-bulb />
              <path d="M14 35 C22 20 38 50 46 35" />
              <text x="30" y="96">Load</text>
            </g>
            <g class="resistor" transform="translate(345 90)">
              <path d="M0 20 h25 l10 -18 l20 36 l20 -36 l20 36 l10 -18 h25" />
              <text x="65" y="62">Resistance</text>
              <text class="resistance-label" data-svg-resistance x="65" y="84">20 Ω</text>
            </g>
            <circle class="charge charge-one" data-charge r="9">
              <animateMotion data-charge-motion dur="4s" begin="0s" repeatCount="indefinite" calcMode="linear">
                <mpath href="#charge-path" />
              </animateMotion>
            </circle>
            <circle class="charge charge-two" data-charge r="9">
              <animateMotion data-charge-motion dur="4s" begin="-1s" repeatCount="indefinite" calcMode="linear">
                <mpath href="#charge-path" />
              </animateMotion>
            </circle>
            <circle class="charge charge-three" data-charge r="9">
              <animateMotion data-charge-motion dur="4s" begin="-2s" repeatCount="indefinite" calcMode="linear">
                <mpath href="#charge-path" />
              </animateMotion>
            </circle>
            <circle class="charge charge-four" data-charge r="9">
              <animateMotion data-charge-motion dur="4s" begin="-3s" repeatCount="indefinite" calcMode="linear">
                <mpath href="#charge-path" />
              </animateMotion>
            </circle>
          </svg>
        </div>

        <div class="lab-controls" aria-label="Circuit controls">
          <label class="control">
            <span>Voltage, the push from the battery</span>
            <input data-voltage type="range" min="1" max="12" step="0.1" value="5" />
            <output data-voltage-output>5.0 V</output>
          </label>
          <label class="control">
            <span>Resistance, the limit on flow</span>
            <input data-resistance type="range" min="2" max="80" step="1" value="20" />
            <output data-resistance-output>20 Ω</output>
          </label>
          <label class="control">
            <span>Time, how long energy is transferred</span>
            <input data-time type="range" min="1" max="60" step="1" value="10" />
            <output data-time-output>10 s</output>
          </label>
          <label class="switch-control">
            <input data-loop type="checkbox" checked />
            <span>Close the loop</span>
          </label>
        </div>

        <div class="meters" aria-label="Circuit readings">
          <div class="meter">
            <span>Current</span>
            <strong data-current>0.25 A</strong>
            <p>Current is flow. It rises with voltage and falls with resistance.</p>
          </div>
          <div class="meter">
            <span>Power</span>
            <strong data-power>1.25 W</strong>
            <p>Power is work per second. It depends on both push and flow.</p>
          </div>
          <div class="meter">
            <span>Energy transferred</span>
            <strong data-energy>12.5 J</strong>
            <p>Energy grows as power continues over time.</p>
          </div>
        </div>

        <aside class="formula-card" aria-label="Formulas used in this lab">
          <h2>The relationships</h2>
          <ul>
            <li><strong>Current</strong> = voltage divided by resistance.</li>
            <li><strong>Power</strong> = voltage multiplied by current.</li>
            <li><strong>Energy</strong> = power multiplied by time.</li>
            <li>If the loop opens, sustained current stops.</li>
          </ul>
        </aside>
      </section>
    )}
  {isStaticChargeLab ? (
    <script type="module" src="/scripts/static-charge-lab.js"></script>
  ) : isSwitchLab ? (
    <script type="module" src="/scripts/switch-circuit-lab.js"></script>
  ) : isOhmsLawLab ? (
    <script type="module" src="/scripts/ohms-law-lab.js"></script>
  ) : isDcVsAcLab ? (
    <script type="module" src="/scripts/ac-dc-conversion-lab.js"></script>
  ) : isAdapterLabelLab ? (
    <script type="module" src="/scripts/power-adapter-label-lab.js"></script>
  ) : isPowerEnergyLab ? (
    <script type="module" src="/scripts/power-energy-bill-lab.js"></script>
  ) : isGroundingSafetyLab ? (
    <script type="module" src="/scripts/grounding-safety-lab.js"></script>
  ) : isGeneratorLab ? (
    <script type="module" src="/scripts/generator-induction-lab.js"></script>
  ) : isTransformerGridLab ? (
    <script type="module" src="/scripts/transformer-grid-lab.js"></script>
  ) : isHouseWiringLab ? (
    <script type="module" src="/scripts/house-wiring-protection-lab.js"></script>
  ) : isNeighborhoodDistributionLab ? (
    <script type="module" src="/scripts/neighborhood-distribution-lab.js"></script>
  ) : (
    <script type="module" src="/scripts/energy-flow-lab.js"></script>
  )}

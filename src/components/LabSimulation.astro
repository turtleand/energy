---
interface Props {
  labSlug: string;
}

const { labSlug } = Astro.props;
const isStaticChargeLab = labSlug === 'lesson-2-static-charge-buildup';
---

    {isStaticChargeLab ? (
      <section class="container lab-shell static-charge-shell" aria-labelledby="lab-title" data-static-charge-lab>
        <div class="lab-board static-charge-board">
          <div class="lab-board-header">
            <div>
              <p class="eyebrow">Static charge buildup</p>
              <h2 id="lab-title">Imbalance builds until it sparks.</h2>
            </div>
            <p class="lab-status" data-static-status>Balanced start. Imbalance will build until it sparks.</p>
          </div>

          <div class="static-buildup-stage" aria-label="Automatic static charge buildup and discharge loop">
            <section class="contrast-panel static-panel static-buildup-panel" aria-labelledby="static-panel-title">
              <p class="panel-label">Automatic loop</p>
              <h3 id="static-panel-title">Charge imbalance</h3>
              <div class="static-scene" aria-hidden="true">
                <div class="charged-object charged-object-negative">
                  <span class="charge-dot dot-a">−</span>
                  <span class="charge-dot dot-b">−</span>
                  <span class="charge-dot dot-c">−</span>
                  <span class="charge-dot dot-d">−</span>
                </div>
                <div class="spark-gap" data-spark-gap>
                  <span class="field-line field-line-one"></span>
                  <span class="field-line field-line-two"></span>
                  <span class="field-line field-line-three"></span>
                  <span class="spark" data-spark></span>
                  <span class="spark-label">automatic discharge</span>
                </div>
                <div class="charged-object charged-object-positive">
                  <span class="charge-dot dot-e">+</span>
                  <span class="charge-dot dot-f">+</span>
                  <span class="charge-dot dot-g">+</span>
                </div>
              </div>

              <div class="buildup-meter" aria-hidden="true">
                <div class="buildup-meter-labels">
                  <span>Balanced</span>
                  <span>Critical point</span>
                </div>
                <div class="buildup-track">
                  <span class="buildup-bar" data-tension-bar></span>
                  <span class="critical-marker"></span>
                </div>
              </div>

              <p class="panel-note" data-static-note>The system starts near balance. Imbalance begins to accumulate again.</p>
            </section>
          </div>
        </div>


        <div class="manual-control-shell">
          <button
            class="button button-secondary manual-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="manual-static-controls"
            data-manual-toggle
          >
            Manual controls
          </button>

          <div class="lab-controls manual-controls" id="manual-static-controls" aria-label="Manual static charge controls" data-manual-controls hidden>
            <label class="control">
              <span>Static charge imbalance</span>
              <input data-static-charge type="range" min="0" max="10" step="1" value="1" />
              <output data-static-output>1 / 10</output>
            </label>
            <label class="control">
              <span>Constant buildup rate</span>
              <input data-buildup-rate type="range" min="0.6" max="3" step="0.2" value="1.6" />
              <output data-rate-output>1.6x</output>
            </label>
            <div class="manual-actions">
              <button class="button button-secondary lab-action" type="button" data-discharge>Trigger discharge</button>
              <button class="button button-secondary lab-action" type="button" data-reset>Reset</button>
              <button class="button button-secondary lab-action" type="button" data-pause>Pause loop</button>
            </div>
          </div>
        </div>

        <aside class="formula-card static-model-card" aria-label="Lesson model used in this lab">
          <h2>The simple model</h2>
          <ul>
            <li><strong>Build:</strong> imbalance accumulates over time.</li>
            <li><strong>Threshold:</strong> the system reaches a critical point.</li>
            <li><strong>Discharge:</strong> a spark releases the stored imbalance.</li>
            <li><strong>Reset:</strong> buildup begins again after the spark.</li>
          </ul>
        </aside>
      </section>
    ) : (
      <section class="container lab-shell" aria-labelledby="lab-title" data-energy-lab>
        <div class="lab-board">
          <div class="lab-board-header">
            <div>
              <p class="eyebrow">Simple circuit model</p>
              <h2 id="lab-title">Push, flow, work, loop.</h2>
            </div>
            <p class="lab-status" data-status>Closed loop. Current is flowing.</p>
          </div>

          <svg class="circuit" viewBox="0 0 760 380" role="img" aria-labelledby="circuit-title circuit-desc">
            <title id="circuit-title">Interactive simple circuit diagram</title>
            <desc id="circuit-desc">A battery, wire loop, resistance load, and moving charge markers controlled by voltage and resistance sliders.</desc>
            <defs>
              <linearGradient id="wireGradient" x1="0%" x2="100%">
                <stop offset="0%" stop-color="#38bdf8" />
                <stop offset="100%" stop-color="#f59e0b" />
              </linearGradient>
            </defs>
            <path id="charge-path" class="wire" data-wire d="M170 190 H330 V110 H590 V270 H330 V190 H170" />
            <g class="battery" transform="translate(110 135)">
              <rect width="80" height="110" rx="16" />
              <line x1="80" y1="55" x2="128" y2="55" />
              <text x="40" y="48">Battery</text>
              <text class="battery-voltage" data-svg-voltage x="40" y="72">5.0 V</text>
            </g>
            <g class="load" transform="translate(560 235)">
              <circle cx="30" cy="35" r="38" data-bulb />
              <path d="M14 35 C22 20 38 50 46 35" />
              <text x="30" y="96">Load</text>
            </g>
            <g class="resistor" transform="translate(345 90)">
              <path d="M0 20 h25 l10 -18 l20 36 l20 -36 l20 36 l10 -18 h25" />
              <text x="65" y="62">Resistance</text>
              <text class="resistance-label" data-svg-resistance x="65" y="84">20 Ω</text>
            </g>
            <circle class="charge charge-one" data-charge r="9">
              <animateMotion data-charge-motion dur="4s" begin="0s" repeatCount="indefinite" calcMode="linear">
                <mpath href="#charge-path" />
              </animateMotion>
            </circle>
            <circle class="charge charge-two" data-charge r="9">
              <animateMotion data-charge-motion dur="4s" begin="-1s" repeatCount="indefinite" calcMode="linear">
                <mpath href="#charge-path" />
              </animateMotion>
            </circle>
            <circle class="charge charge-three" data-charge r="9">
              <animateMotion data-charge-motion dur="4s" begin="-2s" repeatCount="indefinite" calcMode="linear">
                <mpath href="#charge-path" />
              </animateMotion>
            </circle>
            <circle class="charge charge-four" data-charge r="9">
              <animateMotion data-charge-motion dur="4s" begin="-3s" repeatCount="indefinite" calcMode="linear">
                <mpath href="#charge-path" />
              </animateMotion>
            </circle>
          </svg>
        </div>

        <div class="lab-controls" aria-label="Circuit controls">
          <label class="control">
            <span>Voltage, the push from the battery</span>
            <input data-voltage type="range" min="1" max="12" step="0.1" value="5" />
            <output data-voltage-output>5.0 V</output>
          </label>
          <label class="control">
            <span>Resistance, the limit on flow</span>
            <input data-resistance type="range" min="2" max="80" step="1" value="20" />
            <output data-resistance-output>20 Ω</output>
          </label>
          <label class="control">
            <span>Time, how long energy is transferred</span>
            <input data-time type="range" min="1" max="60" step="1" value="10" />
            <output data-time-output>10 s</output>
          </label>
          <label class="switch-control">
            <input data-loop type="checkbox" checked />
            <span>Close the loop</span>
          </label>
        </div>

        <div class="meters" aria-label="Circuit readings">
          <div class="meter">
            <span>Current</span>
            <strong data-current>0.25 A</strong>
            <p>Current is flow. It rises with voltage and falls with resistance.</p>
          </div>
          <div class="meter">
            <span>Power</span>
            <strong data-power>1.25 W</strong>
            <p>Power is work per second. It depends on both push and flow.</p>
          </div>
          <div class="meter">
            <span>Energy transferred</span>
            <strong data-energy>12.5 J</strong>
            <p>Energy grows as power continues over time.</p>
          </div>
        </div>

        <aside class="formula-card" aria-label="Formulas used in this lab">
          <h2>The relationships</h2>
          <ul>
            <li><strong>Current</strong> = voltage divided by resistance.</li>
            <li><strong>Power</strong> = voltage multiplied by current.</li>
            <li><strong>Energy</strong> = power multiplied by time.</li>
            <li>If the loop opens, sustained current stops.</li>
          </ul>
        </aside>
      </section>
    )}
  {isStaticChargeLab ? (
    <script type="module" src="/scripts/static-charge-lab.js"></script>
  ) : (
    <script type="module" src="/scripts/energy-flow-lab.js"></script>
  )}
